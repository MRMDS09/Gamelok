{
  "expo": {
    "name": "Dots and Boxes Game",
    "slug": "dots-and-boxes-game",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "androidStatusBar": {
      "hidden": true
    },
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.dotsandboxes.game"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-audio",
      "./plugins/withImmersiveAndroid"
    ]
  }
}
